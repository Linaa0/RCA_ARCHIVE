# Example environment variables (do NOT commit your real .env)
# Copy this to a new file named .env and fill with real values.

# MongoDB connection settings
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=rca_past_papers

# Secret used to sign JWTs
JWT_SECRET=your-strong-jwt-secret

# Default password used by seed script (optional)
SEED_DEFAULT_PASSWORD=changeme123
backend_url=https://api.archive.innov.rw/

# SMTP settings (optional, used for email OTPs)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="RCA Archive" <no-reply@example.com>
