# Server: /opt/configs/rca_archive/.env

NODE_ENV=production
PORT=5009
BASE_URL=https://api.archive.innov.rw
FRONTEND_BASE_URL=https://rcaarchive.innov.rw

# API-only deploy (frontend hosted separately on Vercel or nginx)
SERVE_FRONTEND=false

CORS_ORIGINS=https://rcaarchive.innov.rw,https://rca-archive.vercel.app,http://localhost:3000,http://localhost:3074

JWT_SECRET=change-me-to-a-long-random-secret

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=rca_archive_db

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Use the same authenticated address or domain as SMTP_USER.
EMAIL_FROM="RCA Archive" <your-email@gmail.com>
# For a custom domain, publish SPF, DKIM, and DMARC DNS records for this sender.
# These records are required by mailbox providers for reliable inbox placement.

# Frontend build-time override (optional — default is https://api.archive.innov.rw/api)
# REACT_APP_API_URL=https://api.archive.innov.rw/api
