# Server port
PORT=5077

# Environment mode (development / production)
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=rca_past_papers

# Secret used to sign JWTs (must be at least 32 characters in all environments)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long

# Optional admin bootstrap secret for the bootstrap endpoint
ADMIN_BOOTSTRAP_SECRET=

# Comma-separated list of admin email addresses
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# Comma-separated list of teacher email addresses
TEACHER_EMAILS=teacher@example.com

# Test seed credentials (used by scripts/reset-db.js and scripts/create-admin.js)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin User
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=
SEED_TEACHER_NAME=Teacher User
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=
SEED_STUDENT_NAME=Student User
SEED_STUDENT_CLASS=Y1A

# Application URLs
BASE_URL=http://localhost:5077
FRONTEND_BASE_URL=http://localhost:3074

# Allowed CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:3074

# SMTP settings for sending verification and notification emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=
EMAIL_FROM="RCA Archive" <no-reply@example.com>

# Optional directories
# UPLOADS_DIR=
# SUBMISSIONS_DIR=

