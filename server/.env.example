# Server port
PORT=5077

# Environment mode (development / production). Signup accepts any six-digit OTP
# only in development; production always requires the emailed code.
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=rca_archive_db

# Secret used to sign JWTs (Change this in production!)
JWT_SECRET=your_jwt_secret_key_here

# Admin bootstrap configuration
ADMIN_BOOTSTRAP_SECRET=your_admin_bootstrap_secret_here
ADMIN_BOOTSTRAP_EMAILS=admin@example.com,admin2@example.com

# Admin CLI creation script credentials (scripts/create-admin.js)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=your_strong_admin_password_here
ADMIN_BOOTSTRAP_NAME=Administrator

# Application URLs
BASE_URL=http://localhost:5077
FRONTEND_BASE_URL=http://localhost:3074

# Allowed CORS origins (comma-separated additional origins)
CORS_ORIGINS=https://rcaarchive.innov.rw,https://rca-archive.vercel.app,http://localhost:3000,http://localhost:3074

# SMTP settings (used for email OTPs and password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="RCA Archive" <your_email@gmail.com>

# Extra teacher emails (comma separated). Added on top of the list in src/config/roles.js
# TEACHER_EMAILS=isabellecadeau78@gmail.com
# Where student submissions are stored (not publicly served). Defaults to ../submissions next to UPLOADS_DIR
# SUBMISSIONS_DIR=
